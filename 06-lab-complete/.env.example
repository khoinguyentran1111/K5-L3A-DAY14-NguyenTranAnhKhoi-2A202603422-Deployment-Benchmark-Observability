# ============================================================
# Biến môi trường của agent. KHÔNG ghi secret thật vào file này.
# Dùng: cp .env.example .env  (file .env đã nằm trong .gitignore)
# Trên cloud: đặt các biến này trong dashboard / CLI của nền tảng.
# ============================================================

# Server
PORT=8000
ENVIRONMENT=development
APP_VERSION=1.0.0
LOG_LEVEL=INFO
WEB_CONCURRENCY=2

# Secret — tạo key ngẫu nhiên, vd: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_KEY=change-me

# State store (rate limit + cost). Trong docker compose được ghi đè thành redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# Bảo vệ tốc độ và chi phí
RATE_LIMIT_PER_MINUTE=10
DAILY_BUDGET_USD=1.0
MONTHLY_BUDGET_USD=10.0
